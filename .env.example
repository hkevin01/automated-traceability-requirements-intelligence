# Application
ATRI_ENV=development
ATRI_LOG_LEVEL=INFO
ATRI_API_HOST=0.0.0.0
ATRI_API_PORT=8000

# Data stores
ATRI_DATABASE_URL=postgresql+psycopg://atri:atri@localhost:5432/atri
ATRI_REDIS_URL=redis://localhost:6379/0
ATRI_NEO4J_URI=bolt://localhost:7687
ATRI_NEO4J_USER=neo4j
ATRI_NEO4J_PASSWORD=change-me

# AI providers (set one or more)
OPENAI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
