# Application
ATRI_ENV=development
ATRI_LOG_LEVEL=INFO
ATRI_API_HOST=0.0.0.0
ATRI_API_PORT=8000

# Data stores
ATRI_DATABASE_URL=postgresql+psycopg://atri:atri@localhost:5432/atri
ATRI_REDIS_URL=redis://localhost:6379/0
ATRI_NEO4J_URI=bolt://localhost:7687
ATRI_NEO4J_USER=neo4j
ATRI_NEO4J_PASSWORD=change-me

# AI providers (set one or more)
OPENAI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me

# --- LLM Rationale Enrichment ---
ATRI_LLM_RATIONALE_ENABLED=false
ATRI_OPENAI_API_KEY=
ATRI_OPENAI_MODEL=gpt-4o-mini
ATRI_AZURE_OPENAI_API_KEY=
ATRI_AZURE_OPENAI_ENDPOINT=
ATRI_AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
ATRI_LLM_RATIONALE_CACHE_PATH=data/processed/llm_rationale_cache.json

# --- OIDC / SSO Integration ---
ATRI_OIDC_ENABLED=false
ATRI_OIDC_ISSUER=
ATRI_OIDC_CLIENT_ID=
ATRI_OIDC_JWKS_URI=
ATRI_OIDC_AUDIENCE=

# --- Multi-Tenant Isolation ---
ATRI_MULTI_TENANT_ENABLED=false
ATRI_DEFAULT_TENANT_ID=default
ATRI_TENANT_DATA_ROOT=data/tenants
